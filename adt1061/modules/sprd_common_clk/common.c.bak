#include <linux/mfd/syscon.h>
#include <linux/module.h>
#include <linux/of_address.h>
#include <linux/of_platform.h>
#include <linux/platform_device.h>
#include <linux/regmap.h>

#include "common.h"

static const struct regmap_config sprdclk_regmap_config = {
	.reg_bits	= 32,
	.reg_stride	= 4,
	.val_bits	= 32,
	.max_register	= 0xffff,
	.fast_io	= true,
};

struct sprd_sip_svc_handle __weak *sprd_sip_svc_get_handle(void)
{
	return NULL;
}

static void sprd_clk_sec_set_svc_handle(const struct sprd_clk_desc *desc,
				struct sprd_sip_svc_handle *svc_handle)
{
	int i;
	struct sprd_clk_common *sclk;

	for (i = 0; i < desc->num_clk_clks; i++) {
		sclk = desc->clk_clks[i];
		if (!sclk)
			continue;

		sclk->svc_handle = svc_handle;
	}
}

static void sprd_clk_set_regmap(const struct sprd_clk_desc *desc,
			 struct regmap *regmap)
{
	int i;
	struct sprd_clk_common *cclk;

	for (i = 0; i < desc->num_clk_clks; i++) {
		cclk = desc->clk_clks[i];
		if (!cclk)
			continue;

		cclk->regmap = regmap;
	}
}

int sprd_clk_regmap_init(struct platform_device *pdev,
			 const struct sprd_clk_desc *desc)
{
	void __iomem *base;
	struct device_node *node = pdev->dev.of_node;
	struct regmap *regmap;
	struct sprd_sip_svc_handle *svc_handle;
	struct resource *res;

	if (of_find_property(node, "sprd,syscon", NULL)) {
		regmap = syscon_regmap_lookup_by_phandle(node, "sprd,syscon");
		if (IS_ERR_OR_NULL(regmap)) {
			pr_err("%s: failed to get syscon regmap\n", __func__);
			return PTR_ERR(regmap);
		}
	} else if (of_find_property(node, "sprd,sec-clk", NULL)) {
		svc_handle = sprd_sip_svc_get_handle();
		if (!svc_handle) {
			pr_err("%s: failed to get svc handle\n", __func__);
			return -ENODEV;
		}
		sprd_clk_sec_set_svc_handle(desc, svc_handle);
		return 0;
	} else {
		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
		base = devm_ioremap_resource(&pdev->dev, res);
		if (IS_ERR(base))
			return PTR_ERR(base);

		regmap = devm_regmap_init_mmio(&pdev->dev, base,
					       &sprdclk_regmap_config);
		if (IS_ERR(regmap)) {
			pr_err("failed to init regmap\n");
			return PTR_ERR(regmap);
		}
	}

	sprd_clk_set_regmap(desc, regmap);

	return 0;
}
EXPORT_SYMBOL_GPL(sprd_clk_regmap_init);

int sprd_clk_probe(struct device *dev, struct clk_hw_onecell_data *clkhw)
{
	int i, ret;
	struct clk_hw *hw;
	struct device_node *node = dev->of_node;
	struct regmap *enable_regmap, *power_regmap;
	u32 enable_reg, power_reg;
	u32 enable_mask, power_mask;
	u32 syscon_args[2];

	for (i = 0; i < clkhw->num; i++) {
		const char *name;

		hw = clkhw->hws[i];

		if (!hw)
			continue;

		/*
		 * GKI 6.12 port note: hw->init must be read BEFORE calling
		 * devm_clk_hw_register() - the clk core clears hw->init to
		 * NULL once it has copied what it needs out of it,
		 * regardless of whether registration succeeds or fails.
		 * The original code read hw->init->name only in the
		 * failure branch below, after the call already nulled it
		 * out, which is a NULL deref on every registration failure
		 * (this is what actually crashed here, once composite
		 * clocks started failing .determine_rate validation - see
		 * the composite.c fix).
		 */
		name = hw->init->name;

		ret = devm_clk_hw_register(dev, hw);
		if (ret) {
			dev_err(dev, "Couldn't register clock %d - %s\n",
				i, name);
			return ret;
		}
	}

	ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clkhw);
	if (ret) {
		dev_err(dev, "Failed to add clock provider\n");
		return ret;
	}

	enable_regmap = syscon_regmap_lookup_by_phandle_args(node, "enable", 2, syscon_args);
	if (!IS_ERR(enable_regmap)) {
		enable_reg = syscon_args[0];
		enable_mask = syscon_args[1];
		ret = regmap_update_bits(enable_regmap, enable_reg, enable_mask, 0);
		if (ret)
			return ret;
	} else {
		/*
		 * GKI 6.12 port note: node->name faulted at runtime - this
		 * device's struct device_node->name field isn't reliably
		 * populated (NULL) the way the old vendor kernel's DT core
		 * guaranteed, and dev_dbg()'s "%s" dereferences it
		 * unconditionally (dynamic debug still evaluates/formats the
		 * args even when the message isn't printed). %pOFn takes the
		 * device_node pointer itself and safely prints "(null)"
		 * instead of crashing if it's ever NULL.
		 */
		dev_dbg(dev, "%pOFn has no enable syscon\n", node);
	}

	power_regmap = syscon_regmap_lookup_by_phandle_args(node, "power", 2, syscon_args);
	if (!IS_ERR(power_regmap)) {
		power_reg = syscon_args[0];
		power_mask = syscon_args[1];
		ret = regmap_update_bits(power_regmap, power_reg, power_mask,
					 power_mask);
		if (ret)
			return ret;
	} else {
		/* See the %pOFn note above the enable-syscon lookup. */
		dev_dbg(dev, "%pOFn has no power syscon\n", node);
	}

	return 0;
}
EXPORT_SYMBOL_GPL(sprd_clk_probe);

MODULE_LICENSE("GPL v2");